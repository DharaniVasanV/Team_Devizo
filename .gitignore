# ---------------------------------------------------
# GigGuard AI - Integrated Project GitIgnore
# ---------------------------------------------------

# 1. System & OS Files
.DS_Store
Thumbs.db
*.log
logs/

# 2. Editor & IDE Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 3. Environment & Secrets (CRITICAL)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!backend/.env.example
!frontend/.env.example

# 4. Dependency Directories
node_modules/
jspm_packages/
package-lock.json (if you prefer yarn)
# yarn.lock (if you prefer npm)

# 5. Build & Output
dist/
build/
out/
.next/

# 6. Python / ML Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
pip-log.txt
pip-delete-this-directory.txt
.venv
.env/
.virtualenv

# 7. Data & Models
# We ignore raw dataset CSVs but KEEP the trained models (.pkl)
data/*.csv
data/*.json
!ML/anomaly_model.pkl
!ML/scaler.pkl
!ML/risk_model.pkl

# 8. Logs & Errors
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
